/build/
/game/build/
/game/data/*
!/game/data/.gitkeep
/game/pak_src/
/game/nitrofs/
/game/include/*
!/game/include/.gitkeep
/game/icon.gif
/game/*.nds
/game/*.elf
/third_party/
